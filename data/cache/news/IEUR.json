    "title": "Can International Stocks Outperform Once Again in 2026? Here's What Nobel Prize Economist Robert Shiller Has to Say.",
    "author": "Adam Levy",
    "published_utc": "2026-01-31T19:27:00Z",
    "article_url": "https://www.fool.com/investing/2026/01/31/international-stocks-outperform-robert-shiller/?source=iedfolrf0000001",
    "tickers": [
      "VXUS",
      "IEUR",
      "FLJH"
    ],
    "image_url": "https://g.foolcdn.com/image/?url=https%3A%2F%2Fg.foolcdn.com%2Feditorial%2Fimages%2F853563%2Fgettyimages-buttons-international-flags.jpg&w=1200&op=resize",
    "description": "International stocks significantly outperformed U.S. stocks in 2025, gaining 32.6% versus the S&P 500's 16.4%. Nobel Prize economist Robert Shiller warns that U.S. stocks face muted returns ahead due to historically high valuations, with his CAPE ratio model forecasting only 1.5% average annual returns over the next decade. In contrast, Shiller expects European stocks to return 8.2% annually and Japanese stocks 6.5% annually, suggesting international markets may continue outperforming in 2026.",
    "keywords": [
      "international stocks",
      "S&P 500",
      "valuation",
      "CAPE ratio",
      "Robert Shiller",
      "stock market forecast",
      "diversification",
      "Europe",
      "Japan"
    ],
    "insights": [
      {
        "ticker": "VXUS",
        "sentiment": "positive",
        "sentiment_reasoning": "International stocks outperformed U.S. markets in 2025 and trade at more attractive valuations relative to historical averages. Shiller's forecasts suggest European and Japanese stocks will deliver superior returns (8.2% and 6.5% annually respectively) over the next decade, making this ETF an appealing diversification option."
      },
      {
        "ticker": "IEUR",
        "sentiment": "positive",
        "sentiment_reasoning": "European stocks trade at relatively calm valuations compared to U.S. equities and Shiller forecasts 8.2% average annual returns over the next decade, supporting continued outperformance potential in 2026 and beyond."
      },
      {
        "ticker": "FLJH",
        "sentiment": "positive",
        "sentiment_reasoning": "Japanese stocks remain relatively cheap compared to U.S. equities and Shiller projects 6.5% average annual returns over the next decade, though valuations may be distorted by the 1980s bubble, offering attractive diversification opportunities."
      }
    ]
  },
